# caddylogs attack-URI rules — organized by vulnerability class.
#
# One rule per line. Blank lines and lines starting with `#` are ignored.
# A line beginning with `re:` is a case-insensitive RE2 regex (the engine is
# linear-time, so the broad alternations below are safe); a plain line is a
# case-insensitive substring. Both match against the request URI (path+query).
# Regexes are matched against the original-case URI, so each carries an inline
# `(?i)`. The `reason=` prefix names the bucket shown in the dashboard.
#
# NOTE: this deployment serves NO server-side scripts (it's a Go app), so any
# request for a .php/.asp/.jsp/.cgi resource, a dotfile, or a config/secret file
# is a probe by definition. The buckets below lean on that: they are tuned to be
# aggressive on this site's surface while not matching any of its real paths
# (pages, /img assets, /dl/*.uf2 firmware, /SB/* builds, /api/*).

# ── WordPress — the single most-scanned surface ──────────────────────────────
re: wordpress=(?i)(wp-login|wp-admin|wp-content|wp-includes|wp-config|xmlrpc\.php|wlwmanifest|/wp-json/|/wordpress/|/wp/)

# ── PHP scripts / webshells / backdoor checks (no legit PHP here) ─────────────
re: php-probe=(?i)\.(php|phtml|php[0-9]?)($|[?/])

# ── Other server-side scripts (ASP / JSP / CGI / Struts .action) ─────────────
re: script-probe=(?i)\.(asp|aspx|jsp|jspx|cgi|action)($|[?/])

# ── Exposed config / env / secrets ───────────────────────────────────────────
# dotfiles that leak VCS, cloud creds, editor/shell state:
re: secret-file=(?i)/\.(env|git|aws|ssh|svn|hg|docker|vscode|idea|npmrc|netrc|htpasswd|htaccess|ds_store|bash_history)(/|$|\.)
# named config/secret files by keyword + extension (appsettings.json, application.yml,
# docker-compose.yml, *.tfstate, service-account.json, sftp-config.json, parameters.yml…):
re: secret-file=(?i)/[a-z0-9_.-]{0,40}(env|config|compose|secret|credential|appsettings|application|parameters|serverless|terraform|service-account)[a-z0-9_.-]{0,40}\.(json|ya?ml|ini|xml|env|properties|toml|tfstate|pem|key|py)($|[?])
# private keys, credential dirs, framework log leaks:
re: secret-file=(?i)(id_rsa|id_dsa|/credentials|/secrets|\.pem($|[?])|/storage/logs/)

# ── Backups & DB dumps ───────────────────────────────────────────────────────
re: backup-dump=(?i)((/backup|/dump|/database|/db)[a-z0-9_.-]{0,40}\.(sql|zip|tar|t?gz|7z|rar|bak)($|[?])|\.(sql|bak|old|swp)($|[?]))

# ── Admin / login panels & DB managers ───────────────────────────────────────
re: admin-panel=(?i)(/wp-admin|/administrator|/manager/html|/cpanel|/plesk|/dbadmin|/myadmin|/pma|/adminer|/phpmyadmin|/user/login|/admin/(login|config|index))

# ── Framework / app CVE probes (Spring, Solr, Laravel, ThinkPHP, Jira, …) ─────
re: framework-cve=(?i)(/actuator|/solr/|/jenkins|/hudson|/_ignition|/vendor/phpunit|/telescope|thinkphp|struts|/druid/|/_profiler|/debug/default|jira-web|/meta-inf/|/web-inf/)

# ── API / service discovery & enumeration ────────────────────────────────────
re: api-discovery=(?i)(/swagger|/api-docs|/openapi|/graphql|/v2/_catalog|/v2/api-docs|/_all_dbs|/api/jsonws)

# ── Server info leaks (Spring /actuator/* is owned by framework-cve above) ───
re: server-info=(?i)(/phpinfo|/info\.php|server-status|server-info)

# ── Router / IoT device exploits ─────────────────────────────────────────────
re: router-iot=(?i)(/boaform|/hnap1|/goform|/gponform|/setup\.cgi|/cgi-bin/|/dana-na/|/currentsetting\.htm)

# ── Cloud metadata (SSRF targets) ────────────────────────────────────────────
re: cloud-metadata=(?i)(/latest/meta-data|/computemetadata|/metadata/identity|169\.254\.169\.254)

# ── Path traversal / LFI ─────────────────────────────────────────────────────
re: traversal-lfi=(?i)(\.\.(/|\\|%2f|%5c)|%2e%2e|/etc/passwd|php://|/proc/self)

# ── Exchange / OWA ───────────────────────────────────────────────────────────
re: exchange=(?i)(/owa/|/ecp/|/autodiscover|/ews/exchange)

# ── RCE / injection markers (Log4Shell, shellshock, command injection) ───────
re: rce-injection=(?i)(\$\{jndi:|/bin/(sh|bash)|;(wget|curl)|eval\(|system\()
